{
  "name": "@foxglove/mcap-benchmarks",
  "description": "MCAP benchmarks",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -b",
    "lint:ci": "tsc -b && eslint .",
    "lint": "tsc -b && eslint --fix .",
    "bench": "tsc -b && node --huge-max-old-generation-size --expose-gc --import tsx index.ts",
    "bench:debug": "tsc -b && node --huge-max-old-generation-size --inspect-brk --expose-gc --import tsx index.ts"
  },
  "devDependencies": {
    "@foxglove/eslint-plugin": "2.1.2",
    "@foxglove/tsconfig": "3.2.0",
    "@mcap/core": "*",
    "@types/node": "20.19.43",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "commander": "12.1.0",
    "eslint": "9.39.5",
    "prettier": "3.1.0",
    "tsx": "4.23.5",
    "typescript": "5.9.3"
  }
}
